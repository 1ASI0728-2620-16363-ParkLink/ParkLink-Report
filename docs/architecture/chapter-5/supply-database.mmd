erDiagram
    PARKING_SPACES ||--|{ AVAILABILITY_WINDOWS : contains
    PARKING_SPACES ||--o{ PARKING_PHOTOS : contains
    PARKING_SPACES {
        uuid id PK
        uuid owner_id "external Identity reference; NOT FK"
        varchar name "NOT NULL"
        varchar address "NOT NULL"
        varchar reference "NOT NULL"
        decimal latitude "CHECK -90 to 90"
        decimal longitude "CHECK -180 to 180"
        numeric price_per_hour "CHECK greater or equal 0"
        char currency "PEN; NOT NULL"
        varchar status "CHECK AVAILABLE DISABLED"
        bigint version "CHECK greater or equal 0"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }
    AVAILABILITY_WINDOWS {
        uuid id PK
        uuid parking_space_id FK "NOT NULL"
        smallint day_of_week "CHECK 0 to 6"
        time opening_time "NOT NULL"
        time closing_time "CHECK after opening_time"
    }
    PARKING_PHOTOS {
        uuid id PK
        uuid parking_space_id FK "NOT NULL"
        varchar object_key UK "NOT NULL"
        boolean verified "DEFAULT false"
    }
