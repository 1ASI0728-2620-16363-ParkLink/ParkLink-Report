flowchart LR
    subgraph Core[Core Domain]
        Reservation[Reservation Management]:::core
    end

    subgraph Supporting[Supporting Subdomains]
        Supply[Parking Supply]:::supporting
        Discovery[Parking Discovery]:::supporting
        Payment[Payment]:::supporting
        Agent[Conversational Reservation Agent]:::supporting
    end

    subgraph Generic[Generic Subdomains]
        Identity[User & Identity]:::generic
        Notification[Notification]:::generic
        Audit[Audit]:::generic
    end

    PaymentProvider[(Payment Provider)]:::external
    LLMProvider[(LLM Provider)]:::external

    Identity -->|Open Host Service: identidad delegada| Agent
    Identity -->|Open Host Service: autenticación| Reservation
    Supply -->|Customer / Supplier: oferta| Discovery
    Supply -->|Customer / Supplier: reglas del espacio| Reservation
    Discovery -->|Open Host Service: opciones| Agent
    Agent -->|Customer / Supplier: comandos confirmados| Reservation
    Reservation -->|Customer / Supplier: autorización| Payment
    Payment -->|Published Language: resultados de pago| Reservation
    Reservation -->|Published Language: estados| Discovery
    Reservation -->|Published Language: eventos| Notification
    Identity -->|Conformist: eventos auditables| Audit
    Supply -->|Conformist: eventos auditables| Audit
    Reservation -->|Conformist: eventos auditables| Audit
    Payment -->|Conformist: eventos auditables| Audit
    Agent -->|Conformist: eventos auditables| Audit
    Notification -->|Conformist: entregas auditables| Audit
    Payment -->|Anti-Corruption Layer| PaymentProvider
    Agent -->|Anti-Corruption Layer| LLMProvider

