flowchart LR
    M["Aplicación móvil"] --> A["Acceso y cuenta"]
    A --> A1["Registro de conductor / propietario"]
    A --> A2["Inicio de sesión"]
    A --> A3["Perfil y preferencias de notificación"]
    M --> D["Conductor"]
    D --> D1["Buscar: destino, fecha, horario y filtros"]
    D1 --> D2["Mapa y lista de resultados"]
    D2 --> D3["Ficha: tarifa, fotos, horarios y restricciones"]
    D3 --> D4["Resumen, retención y pago"]
    D4 --> D5["Resultado y código de reserva"]
    D --> D6["Mis reservas: activas e historial"]
    D6 --> D7["Detalle, cancelación y estado de reembolso"]
    D6 --> D8["Extensión y pago suplementario"]
    D6 --> D9["Detalle de pago y comprobante"]
    D --> D10["Copilot: conversación, propuesta y confirmación"]
    D10 --> D11["Sugerencias y adaptación ante retrasos"]
    M --> O["Propietario"]
    O --> O1["Mis espacios"]
    O1 --> O2["Publicación: dirección, fotos, medidas y tarifa"]
    O1 --> O3["Horarios, precios y habilitación"]
    O --> O4["Agenda de reservas"]
    O4 --> O5["Detalle y validación de código de ingreso"]
    O --> O6["Ingresos: periodo, detalle y reporte"]
    M --> N["Notificaciones"]
    N -. "Abrir el recurso autorizado" .-> D6
    N -. "Abrir reserva de un espacio propio" .-> O4
